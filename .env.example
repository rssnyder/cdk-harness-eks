# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# These inputs are auto-loaded via dotenv on every `cdk` command
# (real shell environment variables take precedence over .env).

# Harness account identifier the delegate registers against.
HARNESS_ACCOUNT_ID=your-harness-account-id

# Harness delegate token (secret — do not commit the real value).
HARNESS_DELEGATE_TOKEN=your-harness-delegate-token

# Harness manager endpoint (optional; defaults to https://app.harness.io/gratis).
HARNESS_MANAGER_ENDPOINT=https://app.harness.io/gratis

# VPC the EKS cluster is deployed into.
VPC_ID=vpc-xxxxxxxxxxxxxxxxx

# Optional: security groups allowed to reach the private EKS API server on 443
# (comma/space-separated), e.g. a bastion or self-hosted NAT security group.
EKS_API_INGRESS_SECURITY_GROUP_IDS=sg-xxxxxxxxxxxxxxxxx

# Optional: IAM role ARNs granted cluster access via EKS access entries
# (comma/space-separated).
EKS_CLUSTER_ADMIN_ROLE_ARNS=arn:aws:iam::<account-id>:role/<role-name>

# Optional: email subscribed to the SNS topic that EKS audit-log alarms notify.
# If unset, the topic is still created but has no email subscription.
EKS_ALARM_EMAIL=you@example.com
