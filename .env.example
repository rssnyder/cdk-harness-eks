# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# These inputs are auto-loaded via dotenv on every `cdk` command
# (real shell environment variables take precedence over .env).

# Harness account identifier the delegate registers against.
HARNESS_ACCOUNT_ID=your-harness-account-id

# Harness delegate token (secret — do not commit the real value).
HARNESS_DELEGATE_TOKEN=your-harness-delegate-token

# Harness manager endpoint (optional; defaults to https://app.harness.io/gratis).
HARNESS_MANAGER_ENDPOINT=https://app.harness.io/gratis

# VPC the EKS cluster is deployed into.
VPC_ID=vpc-xxxxxxxxxxxxxxxxx

# Optional: security groups allowed to reach the private EKS API server on 443
# (comma/space-separated), e.g. a bastion or self-hosted NAT security group.
EKS_API_INGRESS_SECURITY_GROUP_IDS=sg-xxxxxxxxxxxxxxxxx

# Optional: IAM role ARNs granted cluster access via EKS access entries
# (comma/space-separated).
EKS_CLUSTER_ADMIN_ROLE_ARNS=arn:aws:iam::<account-id>:role/<role-name>

# Optional: email subscribed to the SNS topic that EKS audit-log alarms notify.
# If unset, the topic is still created but has no email subscription.
EKS_ALARM_EMAIL=you@example.com

# Optional: Harness delegate container image (repository:tag). Defaults to
# public.ecr.aws/harness/harness/delegate:26.09.90106.
HARNESS_DELEGATE_IMAGE=public.ecr.aws/harness/harness/delegate:26.09.90106

# Optional: host of the Harness OIDC issuer, used to build the IAM OIDC
# provider's URL (https://<host>/ng/api/oidc/account/<HARNESS_ACCOUNT_ID>).
# Defaults to accounts.harness.io.
HARNESS_OIDC_PROVIDER_HOST=accounts.harness.io

# Optional: tags (comma-separated key=value, no spaces in values) applied to all
# AWS resources and as labels on the Kubernetes namespaces.
EKS_TAGS=team=platform,application=harness,environment=dev

# Optional: image registry prefixes (comma/space-separated, trailing '/') pods in
# app namespaces may pull from, e.g. <acct>.dkr.ecr.<region>.amazonaws.com/.
# Unset = no policy. By default violations only warn/audit; set
# EKS_ENFORCE_IMAGE_REGISTRIES=true to deny.
# Examples: the public ECR delegate image, and/or your ECR pull-through cache
# (then also point HARNESS_DELEGATE_IMAGE at the cached path).
# EKS_ALLOWED_IMAGE_REGISTRIES=public.ecr.aws/
# EKS_ALLOWED_IMAGE_REGISTRIES=<account-id>.dkr.ecr.<region>.amazonaws.com/ecr-public/
EKS_ALLOWED_IMAGE_REGISTRIES=
EKS_ENFORCE_IMAGE_REGISTRIES=false

# Optional: deployment environment (dev|test|prod) for persona access. Default dev.
EKS_ENVIRONMENT=dev

# Optional: persona=roleArn pairs (engineer|devops|support|breakglass), comma-separated.
# Engineer: dev=namespace admin, test=view, prod=none. DevOps=edit. Support=view (no exec).
# Breakglass=cluster admin and triggers an audit-log alarm on use.
# EKS_ACCESS_ENTRIES=engineer=arn:aws:iam::<acct>:role/<name>,breakglass=arn:aws:iam::<acct>:role/<name>

# Optional: install the GuardDuty runtime agent add-on (leave off if org GuardDuty auto-manages it).
EKS_ENABLE_GUARDDUTY_AGENT=false

# Optional: ECR repositories to create (KMS, scan-on-push, immutable tags).
# EKS_ECR_REPOSITORIES=my-app,my-other-app

# Optional: deploy Velero (cluster-state backups to an encrypted S3 bucket).
EKS_ENABLE_VELERO=false

# Optional: short cluster name; resources are named {environment}-{clustername}-... Default buildfarm.
EKS_CLUSTER_NAME=buildfarm

# Optional: CIDRs allowed to reach the EKS API over the public endpoint (comma/space-separated).
# Unset = private-only (the guardrail default). For testing only, e.g. your workstation /32.
# EKS_PUBLIC_ENDPOINT_CIDRS=203.0.113.10/32

# Preferred: name of an existing Secrets Manager secret (plain-string delegate token,
# created out of band) synced into the cluster by External Secrets Operator.
# When set, HARNESS_DELEGATE_TOKEN is not needed and never enters the template.
# HARNESS_DELEGATE_TOKEN_SECRET_NAME=harness/delegate-token
